                        "type": "string"
                      },
                      "triangles": {
                        "type": "integer"
                      },
                      "vertices": {
                        "type": "integer"
                      },
                      "shells": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
