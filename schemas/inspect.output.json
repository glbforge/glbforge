              "required": [
                "shells",
                "watertight",
                "meshes"
              ],
              "additionalProperties": false,
              "description": "Welded space: UV seams are not holes; null when topology was disabled"
            },
            "scale": {
              "type": "object",
              "properties": {
                "units": {
