{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://glbforge.dev/schemas/0.7.0/inspect.output.json",
  "title": "inspect.output",
  "description": "Response envelope of the inspect tool.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "false only when the tool could not run; an asset with errors in it is still ok:true"
    },
    "summary": {
      "type": "string",
      "description": "One line, human-readable"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "FILE_NOT_FOUND",
              "FILE_UNREADABLE",
              "FORMAT_UNSUPPORTED",
              "GLTF_VERSION_UNSUPPORTED",
              "EXTENSION_UNSUPPORTED",
              "BUFFER_UNRESOLVED",
              "USDZ_ENTRY_COMPRESSED",
              "USDZ_ENTRY_MISALIGNED",
              "USDZ_FILE_TYPE_DISALLOWED",
              "USDZ_NO_LAYER",
              "USDZ_LAYER_NOT_FIRST",
              "USDZ_NESTED_PACKAGE",
              "USDZ_ARCHIVE_INVALID",
              "MISSING_DEFAULT_PRIM",
              "DEFAULT_PRIM_NOT_FOUND",
              "UP_AXIS_Z",
              "MISSING_UP_AXIS",
              "METERS_PER_UNIT_NONSTANDARD",
              "MISSING_METERS_PER_UNIT",
              "UNRESOLVED_COMPOSITION_ARC",
              "USD_SCHEMA_ERROR",
              "MESH_INDEX_OUT_OF_RANGE",
              "PRIM_TYPE_UNSUPPORTED_ARKIT",
              "SHADER_NOT_PREVIEWSURFACE",
              "SUBDIVISION_UNSUPPORTED",
              "MESH_EMPTY",
              "MESH_NON_MANIFOLD",
              "MESH_DEGENERATE_FACES",
              "TOPO_OPEN_EDGES",
              "TOPO_SHELLS",
              "TOPO_FLOATING_FRAGMENTS",
              "NORMALS_MISSING",
              "NORMALS_INVERTED",
              "UV_MISSING",
              "UV_OUT_OF_RANGE",
              "MESH_UNINDEXED",
              "MESH_UNWELDED",
              "SCALE_TOO_SMALL",
              "SCALE_TOO_LARGE",
              "PIVOT_NOT_AT_BASE",
              "ORIGIN_OUTSIDE_BOUNDS",
              "XFORM_UNAPPLIED",
              "XFORM_MIRRORED",
              "XFORM_NON_UNIFORM_SCALE",
              "INTENT_UP_AXIS",
              "INTENT_UNITS",
              "INTENT_SHELLS",
              "INTENT_WATERTIGHT",
              "INTENT_SIZE",
              "INTENT_CATEGORY_SCALE",
              "INTENT_CATEGORY_UNKNOWN",
