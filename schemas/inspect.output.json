              "CLIP_FORMAT_UNSUPPORTED",
              "DRY_RUN",
              "ROUTED_TO_GENERATION",
              "TOOL_ERROR"
            ],
            "description": "Stable, enumerable code — branch on this, not on message text"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ],
            "description": "error = fatal / will not load; warning = loads but likely wrong (or changed without being asked); info = advisory"
          },
          "prim_path": {
            "type": "string",
            "description": "USD prim path, or the derived path for glTF objects (/Asset/<Node>_<i>/Prim_<j>, /Asset/Materials/…); \"\" for file-level"
          },
          "property": {
            "type": "string",
            "description": "Property / attribute the issue concerns"
          },
          "message": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string",
            "description": "Concrete next step, naming the tool call when one fixes it"
          },
          "data": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "code",
          "severity",
          "prim_path",
          "message"
        ],
        "additionalProperties": false,
        "description": "One diagnostic"
      },
      "description": "Every diagnostic (error, warning, info), errors first"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "format": {
              "type": "string",
              "enum": [
                "glb",
                "gltf",
                "usdz",
