                    "type": "string"
                  }
                }
              },
              "required": [
                "optimized",
                "forged",
                "evidence"
              ],
              "additionalProperties": false,
              "description": "What the file metadata says about where it has been — evidence, not proof"
            },
            "summary": {
              "type": "string",
