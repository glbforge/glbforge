                },
                "plausibility_basis": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "category": {
                          "type": "string"
                        },
                        "typical_m": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": [
