{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://glbforge.dev/schemas/0.5.0/generate_image_to_3d.input.json",
  "title": "generate_image_to_3d.input",
  "description": "Arguments of the generate_image_to_3d tool.",
  "type": "object",
  "properties": {
    "image": {
      "type": "string",
      "description": "Local path or http(s) URL of the source image"
    },
    "model": {
      "type": "string",
      "enum": [
        "hunyuan",
        "trellis",
        "triposr"
      ],
      "default": "hunyuan"
    }
  },
  "required": [
    "image"
  ],
  "additionalProperties": false
}
