{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://glbforge.dev/schemas/0.5.0/audit_directory.input.json",
  "title": "audit_directory.input",
  "description": "Arguments of the audit_directory tool.",
  "type": "object",
  "properties": {
    "dir": {
      "type": "string",
      "description": "Absolute directory path"
    },
    "profile": {
      "type": "string",
      "description": "Budget profile: mobile-hero | desktop-hero | product-configurator; pin a version with name@N (e.g. mobile-hero@1)",
      "default": "mobile-hero"
    },
    "recursive": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "dir"
  ],
  "additionalProperties": false
}
