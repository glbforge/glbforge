{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://glbforge.dev/schemas/0.6.0/render_preview.input.json",
  "title": "render_preview.input",
  "description": "Arguments of the render_preview tool.",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Absolute path to the .glb"
    },
    "view": {
      "type": "string",
      "enum": [
        "thumbnail",
        "turntable"
      ],
      "default": "turntable"
    },
    "size": {
      "type": "integer",
      "minimum": 64,
      "maximum": 1024,
      "default": 256,
      "description": "Pixels per view"
    },
    "out": {
      "type": "string",
      "description": "Absolute path to also save the PNG"
    }
  },
  "required": [
    "path"
  ],
  "additionalProperties": false
}
