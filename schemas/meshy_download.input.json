{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://glbforge.dev/schemas/0.8.0/meshy_download.input.json",
  "title": "meshy_download.input",
  "description": "Arguments of the meshy_download tool.",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "image-to-3d",
        "text-to-3d",
        "remesh",
        "retexture"
      ]
    },
    "taskId": {
      "type": "string"
    },
    "out": {
      "type": "string",
      "description": "Absolute output path for the .glb"
    },
    "preview": {
      "type": "string",
      "enum": [
        "thumbnail",
        "turntable",
        "compare",
        "none"
      ],
      "default": "thumbnail",
      "description": "Rendered PNG of the downloaded model returned with the result: thumbnail (one 3/4 view) | turntable (4 angles tiled 2x2) | none"
    },
    "render": {
      "type": "boolean",
      "description": "Checkpoint render: true = attach a thumbnail even if preview=none, false = no image (overrides preview)"
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "Compute everything in memory and return the diff it would apply; write nothing"
    }
  },
  "required": [
    "kind",
    "taskId",
    "out"
  ],
  "additionalProperties": false
}
