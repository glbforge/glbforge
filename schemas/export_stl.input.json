{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://glbforge.dev/schemas/0.8.0/export_stl.input.json",
  "title": "export_stl.input",
  "description": "Arguments of the export_stl tool.",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Absolute path to the .glb"
    },
    "out": {
      "type": "string",
      "description": "Absolute output path for the .stl"
    },
    "sizeMm": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 80,
      "description": "Largest printed dimension in millimeters"
    },
    "preview": {
      "type": "string",
      "enum": [
        "thumbnail",
        "turntable",
        "compare",
        "none"
      ],
      "default": "thumbnail",
      "description": "Rendered PNG of the exported geometry returned with the result: thumbnail (one 3/4 view) | turntable (4 angles tiled 2x2) | none"
    },
    "render": {
      "type": "boolean",
      "description": "Checkpoint render: true = attach a thumbnail even if preview=none, false = no image (overrides preview)"
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "Compute everything in memory and return the diff it would apply; write nothing"
    }
  },
  "required": [
    "path",
    "out"
  ],
  "additionalProperties": false
}
