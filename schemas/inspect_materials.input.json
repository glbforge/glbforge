{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://glbforge.dev/schemas/0.5.0/inspect_materials.input.json",
  "title": "inspect_materials.input",
  "description": "Arguments of the inspect_materials tool.",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Absolute path to a .glb, .gltf, .usdz, .usda, .usdc or .usd file"
    },
    "oversized_threshold": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "default": 2048,
      "description": "Pixels; TEXTURE_OVERSIZED above this on either axis"
    }
  },
  "required": [
    "path"
  ],
  "additionalProperties": false
}
