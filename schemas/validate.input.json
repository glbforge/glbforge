{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://glbforge.dev/schemas/0.5.0/validate.input.json",
  "title": "validate.input",
  "description": "Arguments of the validate tool.",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Absolute path to a .glb, .gltf, .usdz, .usda, .usdc or .usd file"
    },
    "profile": {
      "type": "string",
      "default": "ios_ar",
      "description": "mode=full only: performance profile for the budget check (default ios_ar)"
    },
    "mode": {
      "type": "string",
      "enum": [
        "quick",
        "full"
      ],
      "default": "quick"
    }
  },
  "required": [
    "path"
  ],
  "additionalProperties": false
}
