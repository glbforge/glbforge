{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://glbforge.dev/schemas/0.7.0/inspect_geometry.input.json",
  "title": "inspect_geometry.input",
  "description": "Arguments of the inspect_geometry tool.",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Absolute path to a .glb, .gltf, .usdz, .usda, .usdc or .usd file"
    },
    "small_scale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 0.01,
      "description": "Metres; SCALE_TOO_SMALL below this"
    },
    "large_scale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 20,
      "description": "Metres; SCALE_TOO_LARGE above this"
    },
    "topology": {
      "type": "boolean",
      "default": true,
      "description": "Run the manifold / degenerate edge pass (O(n); skip for speed on huge meshes)"
    }
  },
  "required": [
    "path"
  ],
  "additionalProperties": false
}
