// Cloudflare Worker for glbforge.dev: static site + edge API (auth,
// metered Meshy generation, Stripe billing). The D1 binding is added once
// the database exists — see README "hosted credits" section.
{
  "name": "glbforge",
  "compatibility_date": "2026-08-20",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glbforge",
      "database_id": "2f889e26-24ef-43ff-955e-0d336eddfae5"
    }
  ]
}
