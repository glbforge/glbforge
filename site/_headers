# Hashed bundles and models are immutable; HTML must always revalidate so
# deploys are picked up on the next load (stale index.html serves dead
# bundle references otherwise).
/models/*
  Cache-Control: public, max-age=31536000, immutable
/studio/assets/*
  Cache-Control: public, max-age=31536000, immutable
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/studio/
  Cache-Control: no-cache
/studio/index.html
  Cache-Control: no-cache
# Icons and the manifest live at fixed, unhashed paths, so they must never be
# immutable — a week, then revalidate.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800
/og.png
  Cache-Control: public, max-age=604800
