{
  "name": "@glbforge/studio",
  "version": "0.2.0",
  "description": "GLBForge Studio \u2014 local web UI for the GLBForge pipeline, served by `glbforge ui`.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://glbforge.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glbforge/glbforge.git",
    "directory": "packages/studio"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "node copy-basis.mjs && vite build",
    "test": "vitest run --passWithNoTests",
    "build:site": "node copy-basis.mjs && vite build --base=/studio/ --outDir ../../site/studio --emptyOutDir"
  },
  "devDependencies": {
    "@glbforge/core": "workspace:^",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.18.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.0",
    "meshoptimizer": "^0.22.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.169.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}