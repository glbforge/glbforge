{
  "name": "@glbforge/mcp",
  "version": "0.6.0",
  "type": "module",
  "bin": {
    "glbforge-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx scripts/emit-schemas.ts",
    "test": "vitest run",
    "schemas": "tsx scripts/emit-schemas.ts"
  },
  "dependencies": {
    "@glbforge/core": "workspace:^",
    "@glbforge/meshy": "workspace:^",
    "@gltf-transform/core": "^4.4.2",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "sharp": "^0.35.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod-to-json-schema": "^3.25.2",
    "tsx": "^4.19.0"
  },
  "license": "MIT",
  "homepage": "https://glbforge.dev",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
