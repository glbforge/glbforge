{
  "name": "@glbforge/companion",
  "version": "0.8.0",
  "description": "A GLB that lives on your desktop and talks: transparent always-on-top window, plays the asset's clips, a Claude agent brain on your Claude Code login, and an HTTP + MCP surface so any agent can drive it or be it.",
  "private": false,
  "type": "module",
  "main": "main.mjs",
  "bin": {
    "glbforge-companion": "bin.mjs"
  },
  "files": [
    "bin.mjs",
    "main.mjs",
    "brain.mjs",
    "hook.mjs",
    "hooks.mjs",
    "preload.cjs",
    "mcp.mjs",
    "renderer/",
    "README.md"
  ],
  "scripts": {
    "start": "node bin.mjs",
    "mcp": "node mcp.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "electron": "^33.0.0",
    "three": "^0.169.0",
    "zod": "^3.23.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "glb",
    "gltf",
    "3d",
    "desktop-pet",
    "companion",
    "electron",
    "mcp",
    "claude",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/glbforge/glbforge",
    "directory": "companion"
  },
  "homepage": "https://glbforge.dev",
  "license": "MIT"
}
